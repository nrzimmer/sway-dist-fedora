diff --git a/sway/desktop_entry.c b/sway/desktop_entry.c
new file mode 100644
index 00000000..98113756
--- /dev/null
+++ b/sway/desktop_entry.c
@@ -0,0 +1,394 @@
+#include <ctype.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "list.h"
+#include "log.h"
+#include "stringop.h"
+#include "sway/desktop_entry.h"
+
+struct desktop_entry {
+	char *id; // desktop file ID, without the .desktop suffix
+	char *icon; // may be NULL
+	char *wm_class; // StartupWMClass, may be NULL
+};
+
+// All desktop entries, in order of precedence. NULL until first needed.
+static list_t *desktop_entries = NULL;
+
+static char *strip(char *str) {
+	while (isspace((unsigned char)*str)) {
+		++str;
+	}
+	char *end = str + strlen(str);
+	while (end > str && isspace((unsigned char)end[-1])) {
+		--end;
+	}
+	*end = '\0';
+	return str;
+}
+
+int open_regular_file(const char *path, size_t max_size, struct stat *st) {
+	int fd = open(path, O_RDONLY | O_NONBLOCK | O_CLOEXEC);
+	if (fd < 0) {
+		return -1;
+	}
+	struct stat tmp;
+	if (!st) {
+		st = &tmp;
+	}
+	if (fstat(fd, st) != 0 || !S_ISREG(st->st_mode) || st->st_size < 0 ||
+			(uintmax_t)st->st_size > max_size) {
+		close(fd);
+		return -1;
+	}
+	return fd;
+}
+
+char *read_regular_file(const char *path, size_t max_size, size_t *len,
+		struct stat *st) {
+	struct stat tmp;
+	if (!st) {
+		st = &tmp;
+	}
+	int fd = open_regular_file(path, max_size, st);
+	if (fd < 0) {
+		return NULL;
+	}
+	size_t size = st->st_size;
+	char *data = malloc(size + 1);
+	size_t done = 0;
+	while (data && done < size) {
+		ssize_t n = read(fd, data + done, size - done);
+		if (n < 0 && errno == EINTR) {
+			continue;
+		}
+		if (n <= 0) {
+			free(data);
+			data = NULL;
+			break;
+		}
+		done += n;
+	}
+	close(fd);
+	if (data) {
+		data[size] = '\0';
+		*len = size;
+	}
+	return data;
+}
+
+bool desktop_file_parse(const char *path, desktop_file_handler_t handler,
+		void *data) {
+	int fd = open_regular_file(path, 4 * 1024 * 1024, NULL);
+	FILE *file = fd >= 0 ? fdopen(fd, "r") : NULL;
+	if (!file) {
+		if (fd >= 0) {
+			close(fd);
+		}
+		return false;
+	}
+
+	char *group = NULL;
+	char *line = NULL;
+	size_t line_size = 0;
+	while (getline(&line, &line_size, file) != -1) {
+		char *str = strip(line);
+		if (str[0] == '\0' || str[0] == '#') {
+			continue;
+		}
+
+		if (str[0] == '[') {
+			char *end = strchr(str, ']');
+			if (!end) {
+				break; // malformed group header
+			}
+			*end = '\0';
+			free(group);
+			group = strdup(str + 1);
+			continue;
+		}
+
+		char *eq = strchr(str, '=');
+		if (!group || !eq) {
+			continue;
+		}
+		*eq = '\0';
+		if (!handler(data, group, strip(str), strip(eq + 1))) {
+			break;
+		}
+	}
+
+	free(line);
+	free(group);
+	fclose(file);
+	return true;
+}
+
+static int cmp_str(const void *item, const void *cmp_to) {
+	return strcmp(item, cmp_to);
+}
+
+list_t *xdg_data_dirs(void) {
+	list_t *dirs = create_list();
+
+	const char *data_home = getenv("XDG_DATA_HOME");
+	const char *home = getenv("HOME");
+	if (data_home && data_home[0] == '/') {
+		list_add(dirs, strdup(data_home));
+	} else if (home && *home) {
+		list_add(dirs, format_str("%s/.local/share", home));
+	}
+
+	const char *data_dirs = getenv("XDG_DATA_DIRS");
+	if (!data_dirs || !*data_dirs) {
+		data_dirs = "/usr/local/share:/usr/share";
+	}
+	list_t *split = split_string(data_dirs, ":");
+	for (int i = 0; i < split->length; ++i) {
+		char *dir = split->items[i];
+		if (dir[0] == '/' && list_seq_find(dirs, cmp_str, dir) == -1) {
+			list_add(dirs, dir);
+		} else {
+			free(dir);
+		}
+	}
+	list_free(split);
+
+	return dirs;
+}
+
+struct entry_parse_state {
+	char *icon;
+	char *wm_class;
+};
+
+static bool handle_desktop_entry_key(void *data, const char *group,
+		const char *key, const char *value) {
+	struct entry_parse_state *state = data;
+	if (strcmp(group, "Desktop Entry") != 0) {
+		// The main group comes first, there's nothing more for us to read
+		return false;
+	}
+	if (strcmp(key, "Icon") == 0 && !state->icon && *value) {
+		state->icon = strdup(value);
+	} else if (strcmp(key, "StartupWMClass") == 0 && !state->wm_class && *value) {
+		state->wm_class = strdup(value);
+	}
+	return true;
+}
+
+static struct desktop_entry *desktop_entry_load(const char *path,
+		const char *id) {
+	struct entry_parse_state state = {0};
+	if (!desktop_file_parse(path, handle_desktop_entry_key, &state)) {
+		return NULL;
+	}
+	struct desktop_entry *entry = calloc(1, sizeof(*entry));
+	if (!entry) {
+		free(state.icon);
+		free(state.wm_class);
+		return NULL;
+	}
+	entry->id = strdup(id);
+	entry->icon = state.icon;
+	entry->wm_class = state.wm_class;
+	return entry;
+}
+
+static void desktop_entry_destroy(struct desktop_entry *entry) {
+	free(entry->id);
+	free(entry->icon);
+	free(entry->wm_class);
+	free(entry);
+}
+
+static struct desktop_entry *find_entry(const char *id) {
+	for (int i = 0; i < desktop_entries->length; ++i) {
+		struct desktop_entry *entry = desktop_entries->items[i];
+		if (strcmp(entry->id, id) == 0) {
+			return entry;
+		}
+	}
+	return NULL;
+}
+
+static bool is_dir(const char *path) {
+	struct stat st;
+	return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static void scan_applications_dir(const char *path, const char *prefix,
+		int depth) {
+	DIR *dir = opendir(path);
+	if (!dir) {
+		return;
+	}
+
+	static const char suffix[] = ".desktop";
+	const size_t suffix_len = strlen(suffix);
+
+	struct dirent *dirent;
+	while ((dirent = readdir(dir))) {
+		const char *name = dirent->d_name;
+		if (name[0] == '.') {
+			continue;
+		}
+		char *child = format_str("%s/%s", path, name);
+		if (!child) {
+			continue;
+		}
+
+		size_t len = strlen(name);
+		bool is_desktop_file = len > suffix_len &&
+			strcmp(name + len - suffix_len, suffix) == 0;
+		if (!is_desktop_file && is_dir(child)) {
+			// Desktop file IDs of entries in subdirectories are prefixed with
+			// the subdirectory name and a dash
+			if (depth < 3) {
+				char *child_prefix = format_str("%s%s-", prefix, name);
+				if (child_prefix) {
+					scan_applications_dir(child, child_prefix, depth + 1);
+					free(child_prefix);
+				}
+			}
+		} else if (is_desktop_file) {
+			char *id = format_str("%s%.*s", prefix,
+				(int)(len - suffix_len), name);
+			// Entries found earlier take precedence
+			if (id && !find_entry(id)) {
+				struct desktop_entry *entry = desktop_entry_load(child, id);
+				if (entry) {
+					list_add(desktop_entries, entry);
+				}
+			}
+			free(id);
+		}
+		free(child);
+	}
+	closedir(dir);
+}
+
+static void load_desktop_entries(void) {
+	if (desktop_entries) {
+		return;
+	}
+	desktop_entries = create_list();
+
+	list_t *data_dirs = xdg_data_dirs();
+	for (int i = 0; i < data_dirs->length; ++i) {
+		char *path = format_str("%s/applications", (char *)data_dirs->items[i]);
+		if (path) {
+			scan_applications_dir(path, "", 0);
+			free(path);
+		}
+	}
+	list_free_items_and_destroy(data_dirs);
+
+	sway_log(SWAY_DEBUG, "Loaded %d desktop entries", desktop_entries->length);
+}
+
+/**
+ * Reads the desktop entry with the given ID directly, in case it has been
+ * installed after the desktop entries were loaded.
+ */
+static struct desktop_entry *load_new_desktop_entry(const char *id) {
+	if (strchr(id, '/')) {
+		return NULL;
+	}
+
+	struct desktop_entry *entry = NULL;
+	list_t *data_dirs = xdg_data_dirs();
+	for (int i = 0; i < data_dirs->length && !entry; ++i) {
+		char *path = format_str("%s/applications/%s.desktop",
+			(char *)data_dirs->items[i], id);
+		if (path) {
+			entry = desktop_entry_load(path, id);
+			free(path);
+		}
+	}
+	list_free_items_and_destroy(data_dirs);
+
+	if (entry) {
+		list_add(desktop_entries, entry);
+	}
+	return entry;
+}
+
+static bool match_id_case_insensitive(struct desktop_entry *entry,
+		const char *app_id) {
+	return strcasecmp(entry->id, app_id) == 0;
+}
+
+static bool match_wm_class(struct desktop_entry *entry, const char *app_id) {
+	return entry->wm_class && strcmp(entry->wm_class, app_id) == 0;
+}
+
+static bool match_wm_class_case_insensitive(struct desktop_entry *entry,
+		const char *app_id) {
+	return entry->wm_class && strcasecmp(entry->wm_class, app_id) == 0;
+}
+
+// Matches reverse-DNS desktop file IDs to their last component, for instance
+// "com.example.Foo" to the app_id "foo"
+static bool match_id_last_component(struct desktop_entry *entry,
+		const char *app_id) {
+	const char *last = strrchr(entry->id, '.');
+	return last && strcasecmp(last + 1, app_id) == 0;
+}
+
+char *desktop_entry_find_icon(const char *app_id) {
+	if (!app_id || !*app_id) {
+		return NULL;
+	}
+
+	load_desktop_entries();
+
+	struct desktop_entry *entry = find_entry(app_id);
+	if (!entry) {
+		entry = load_new_desktop_entry(app_id);
+	}
+
+	bool (*matchers[])(struct desktop_entry *entry, const char *app_id) = {
+		match_id_case_insensitive,
+		match_wm_class,
+		match_wm_class_case_insensitive,
+		match_id_last_component,
+	};
+	size_t n_matchers = sizeof(matchers) / sizeof(matchers[0]);
+	for (size_t i = 0; i < n_matchers && !(entry && entry->icon); ++i) {
+		for (int j = 0; j < desktop_entries->length; ++j) {
+			struct desktop_entry *candidate = desktop_entries->items[j];
+			if (candidate->icon && matchers[i](candidate, app_id)) {
+				entry = candidate;
+				break;
+			}
+		}
+	}
+
+	if (!entry || !entry->icon) {
+		sway_log(SWAY_DEBUG, "No desktop entry with an icon for '%s'", app_id);
+		return NULL;
+	}
+	sway_log(SWAY_DEBUG, "Desktop entry '%s' for '%s' has icon '%s'",
+		entry->id, app_id, entry->icon);
+	return strdup(entry->icon);
+}
+
+void desktop_entries_reset(void) {
+	if (!desktop_entries) {
+		return;
+	}
+	for (int i = 0; i < desktop_entries->length; ++i) {
+		desktop_entry_destroy(desktop_entries->items[i]);
+	}
+	list_free(desktop_entries);
+	desktop_entries = NULL;
+}
diff --git a/sway/icon.c b/sway/icon.c
new file mode 100644
index 00000000..15c1d949
--- /dev/null
+++ b/sway/icon.c
@@ -0,0 +1,589 @@
+#include <cairo.h>
+#include <ctype.h>
+#include <drm_fourcc.h>
+#include <inttypes.h>
+#include <math.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <strings.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/types/wlr_buffer.h>
+#include "config.h"
+#if HAVE_LIBRSVG
+#include <librsvg/rsvg.h>
+#endif
+#include "list.h"
+#include "log.h"
+#include "sway/config.h"
+#include "sway/desktop_entry.h"
+#include "sway/icon.h"
+#include "sway/icon_theme.h"
+
+// Images larger than this aren't loaded
+#define MAX_IMAGE_SIZE 2048
+// Image files larger than this aren't read
+#define MAX_IMAGE_FILE_SIZE (16 * 1024 * 1024)
+// The number of sizes an icon keeps rendered buffers for
+#define MAX_ICON_BUFFERS 4
+// Images provided by a client that we keep: how many, how large (larger ones
+// are scaled down), and the size of images that we ignore
+#define MAX_CLIENT_IMAGES 8
+#define MAX_CLIENT_IMAGE_SIZE 128
+#define MAX_CLIENT_SOURCE_SIZE 1024
+// Lookup results are forgotten once there are more of them than this
+#define MAX_CACHE_ENTRIES 256
+
+enum sway_icon_type {
+	ICON_NAMED, // from the icon theme
+	ICON_FILE, // from an image file
+	ICON_IMAGES, // from pixel data
+};
+
+struct icon_buffer {
+	struct wlr_buffer base;
+	cairo_surface_t *surface;
+};
+
+struct sway_icon {
+	int refs;
+	enum sway_icon_type type;
+	char *name; // the icon name for ICON_NAMED, the path for ICON_FILE
+	list_t *images; // cairo_surface_t *, for ICON_IMAGES
+
+	// Buffers rendered at different sizes, most recently used first
+	struct icon_buffer *buffers[MAX_ICON_BUFFERS];
+};
+
+struct cache_entry {
+	char *key;
+	struct sway_icon *icon; // NULL if there's no icon
+};
+
+static list_t *named_icons = NULL; // struct cache_entry *
+static list_t *app_icons = NULL; // struct cache_entry *
+
+static void icon_buffer_handle_destroy(struct wlr_buffer *wlr_buffer) {
+	struct icon_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	cairo_surface_destroy(buffer->surface);
+	free(buffer);
+}
+
+static bool icon_buffer_handle_begin_data_ptr_access(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct icon_buffer *buffer = wl_container_of(wlr_buffer, buffer, base);
+	if (flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE) {
+		return false;
+	}
+	*data = cairo_image_surface_get_data(buffer->surface);
+	*stride = cairo_image_surface_get_stride(buffer->surface);
+	*format = DRM_FORMAT_ARGB8888;
+	return true;
+}
+
+static void icon_buffer_handle_end_data_ptr_access(struct wlr_buffer *wlr_buffer) {
+	// This space is intentionally left blank
+}
+
+static const struct wlr_buffer_impl icon_buffer_impl = {
+	.destroy = icon_buffer_handle_destroy,
+	.begin_data_ptr_access = icon_buffer_handle_begin_data_ptr_access,
+	.end_data_ptr_access = icon_buffer_handle_end_data_ptr_access,
+};
+
+static cairo_surface_t *create_image_surface(int width, int height) {
+	cairo_surface_t *surface =
+		cairo_image_surface_create(CAIRO_FORMAT_ARGB32, width, height);
+	if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS) {
+		sway_log(SWAY_ERROR, "Failed to create a cairo surface: %s",
+			cairo_status_to_string(cairo_surface_status(surface)));
+		cairo_surface_destroy(surface);
+		return NULL;
+	}
+	return surface;
+}
+
+/**
+ * Paints an image on a size×size surface, scaled to fit and centered.
+ */
+static cairo_surface_t *render_image(cairo_surface_t *image, int size) {
+	int width = cairo_image_surface_get_width(image);
+	int height = cairo_image_surface_get_height(image);
+	if (width <= 0 || height <= 0) {
+		return NULL;
+	}
+	cairo_surface_t *surface = create_image_surface(size, size);
+	if (!surface) {
+		return NULL;
+	}
+
+	double scale = fmin((double)size / width, (double)size / height);
+	if (scale > 1 && scale <= 4.0 / 3) {
+		// Upscaling an image only slightly makes it blurry for little gain:
+		// show it at its original size instead
+		scale = 1;
+	}
+
+	cairo_t *cairo = cairo_create(surface);
+	cairo_translate(cairo, floor((size - width * scale) / 2),
+		floor((size - height * scale) / 2));
+	cairo_scale(cairo, scale, scale);
+	cairo_set_source_surface(cairo, image, 0, 0);
+	cairo_pattern_set_filter(cairo_get_source(cairo), CAIRO_FILTER_GOOD);
+	cairo_paint(cairo);
+	cairo_destroy(cairo);
+	cairo_surface_flush(surface);
+	return surface;
+}
+
+static bool check_png_size(const char *path, const unsigned char *data,
+		size_t len) {
+	if (len < 24 || memcmp(data, "\x89PNG\r\n\x1a\n", 8) != 0 ||
+			memcmp(data + 12, "IHDR", 4) != 0) {
+		sway_log(SWAY_ERROR, "Failed to load icon %s: not a PNG file", path);
+		return false;
+	}
+
+	uint32_t width = (uint32_t)data[16] << 24 | (uint32_t)data[17] << 16 |
+		(uint32_t)data[18] << 8 | data[19];
+	uint32_t height = (uint32_t)data[20] << 24 | (uint32_t)data[21] << 16 |
+		(uint32_t)data[22] << 8 | data[23];
+	if (width > MAX_IMAGE_SIZE || height > MAX_IMAGE_SIZE) {
+		sway_log(SWAY_ERROR, "Not loading icon %s: image too large (%"PRIu32
+			"x%"PRIu32")", path, width, height);
+		return false;
+	}
+	return true;
+}
+
+struct png_reader {
+	const unsigned char *data;
+	size_t len, pos;
+};
+
+static cairo_status_t read_png_data(void *closure, unsigned char *data,
+		unsigned int length) {
+	struct png_reader *reader = closure;
+	if (length > reader->len - reader->pos) {
+		return CAIRO_STATUS_READ_ERROR;
+	}
+	memcpy(data, reader->data + reader->pos, length);
+	reader->pos += length;
+	return CAIRO_STATUS_SUCCESS;
+}
+
+static cairo_surface_t *render_png(const char *path, int size) {
+	// Read the file ourselves, as a regular file: a FIFO would block
+	size_t len = 0;
+	unsigned char *data = (unsigned char *)read_regular_file(path,
+		MAX_IMAGE_FILE_SIZE, &len, NULL);
+	if (!data) {
+		sway_log(SWAY_ERROR, "Failed to load icon %s: unable to read the file "
+			"or file too large", path);
+		return NULL;
+	}
+	if (!check_png_size(path, data, len)) {
+		free(data);
+		return NULL;
+	}
+
+	struct png_reader reader = { .data = data, .len = len };
+	cairo_surface_t *image =
+		cairo_image_surface_create_from_png_stream(read_png_data, &reader);
+	free(data);
+	if (cairo_surface_status(image) != CAIRO_STATUS_SUCCESS) {
+		sway_log(SWAY_ERROR, "Failed to load icon %s: %s", path,
+			cairo_status_to_string(cairo_surface_status(image)));
+		cairo_surface_destroy(image);
+		return NULL;
+	}
+	cairo_surface_t *surface = render_image(image, size);
+	cairo_surface_destroy(image);
+	return surface;
+}
+
+#if HAVE_LIBRSVG
+static cairo_surface_t *render_svg(const char *path, int size) {
+	// Don't let librsvg open the file: going through GIO would load GVfs
+	// modules into the compositor. This also prevents loading external files.
+	size_t len = 0;
+	char *data = read_regular_file(path, MAX_IMAGE_FILE_SIZE, &len, NULL);
+	if (!data) {
+		sway_log(SWAY_ERROR, "Failed to load icon %s: unable to read the file "
+			"or file too large", path);
+		return NULL;
+	}
+
+	GError *error = NULL;
+	RsvgHandle *handle =
+		rsvg_handle_new_from_data((const guint8 *)data, len, &error);
+	free(data);
+	if (!handle) {
+		sway_log(SWAY_ERROR, "Failed to load icon %s: %s", path,
+			error ? error->message : "unknown error");
+		g_clear_error(&error);
+		return NULL;
+	}
+
+	cairo_surface_t *surface = create_image_surface(size, size);
+	if (surface) {
+		cairo_t *cairo = cairo_create(surface);
+		RsvgRectangle viewport = { .x = 0, .y = 0, .width = size, .height = size };
+		if (!rsvg_handle_render_document(handle, cairo, &viewport, &error)) {
+			sway_log(SWAY_ERROR, "Failed to render icon %s: %s", path,
+				error ? error->message : "unknown error");
+			g_clear_error(&error);
+			cairo_surface_destroy(surface);
+			surface = NULL;
+		}
+		cairo_destroy(cairo);
+	}
+	g_object_unref(handle);
+
+	if (surface) {
+		cairo_surface_flush(surface);
+	}
+	return surface;
+}
+#endif
+
+static cairo_surface_t *render_file(const char *path,
+		enum icon_file_format format, int size) {
+	switch (format) {
+	case ICON_FORMAT_PNG:
+		return render_png(path, size);
+	case ICON_FORMAT_SVG:
+#if HAVE_LIBRSVG
+		return render_svg(path, size);
+#else
+		return NULL;
+#endif
+	}
+	return NULL;
+}
+
+static bool has_suffix(const char *str, const char *suffix) {
+	size_t len = strlen(str), suffix_len = strlen(suffix);
+	return len >= suffix_len &&
+		strcasecmp(str + len - suffix_len, suffix) == 0;
+}
+
+static cairo_surface_t *render_images(list_t *images, int size) {
+	// Use the smallest image at least as large as requested, or else the
+	// largest image
+	cairo_surface_t *best = NULL;
+	int best_size = 0;
+	for (int i = 0; i < images->length; ++i) {
+		cairo_surface_t *image = images->items[i];
+		int image_size = MAX(cairo_image_surface_get_width(image),
+			cairo_image_surface_get_height(image));
+		if (!best || (best_size < size ? image_size > best_size :
+				image_size >= size && image_size < best_size)) {
+			best = image;
+			best_size = image_size;
+		}
+	}
+	return best ? render_image(best, size) : NULL;
+}
+
+static cairo_surface_t *icon_render(struct sway_icon *icon, int size) {
+	switch (icon->type) {
+	case ICON_NAMED:;
+		struct icon_file file;
+		if (!icon_theme_find(config->title_window_icon_theme, icon->name, size,
+				&file)) {
+			return NULL;
+		}
+		cairo_surface_t *surface = render_file(file.path, file.format, size);
+		icon_file_finish(&file);
+		return surface;
+	case ICON_FILE:
+		return render_file(icon->name, has_suffix(icon->name, ".svg") ?
+			ICON_FORMAT_SVG : ICON_FORMAT_PNG, size);
+	case ICON_IMAGES:
+		return render_images(icon->images, size);
+	}
+	return NULL;
+}
+
+struct wlr_buffer *sway_icon_get_buffer(struct sway_icon *icon, int size) {
+	if (size <= 0 || size > MAX_IMAGE_SIZE) {
+		return NULL;
+	}
+
+	for (int i = 0; i < MAX_ICON_BUFFERS; ++i) {
+		struct icon_buffer *buffer = icon->buffers[i];
+		if (buffer && buffer->base.width == size) {
+			memmove(&icon->buffers[1], &icon->buffers[0],
+				i * sizeof(icon->buffers[0]));
+			icon->buffers[0] = buffer;
+			return &buffer->base;
+		}
+	}
+
+	cairo_surface_t *surface = icon_render(icon, size);
+	if (!surface) {
+		return NULL;
+	}
+	struct icon_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (!buffer) {
+		cairo_surface_destroy(surface);
+		return NULL;
+	}
+	wlr_buffer_init(&buffer->base, &icon_buffer_impl, size, size);
+	buffer->surface = surface;
+
+	struct icon_buffer *oldest = icon->buffers[MAX_ICON_BUFFERS - 1];
+	if (oldest) {
+		wlr_buffer_drop(&oldest->base);
+	}
+	memmove(&icon->buffers[1], &icon->buffers[0],
+		(MAX_ICON_BUFFERS - 1) * sizeof(icon->buffers[0]));
+	icon->buffers[0] = buffer;
+	return &buffer->base;
+}
+
+static struct sway_icon *icon_create(enum sway_icon_type type,
+		const char *name, list_t *images) {
+	struct sway_icon *icon = calloc(1, sizeof(*icon));
+	if (!icon) {
+		return NULL;
+	}
+	icon->refs = 1;
+	icon->type = type;
+	icon->name = name ? strdup(name) : NULL;
+	icon->images = images;
+	return icon;
+}
+
+struct sway_icon *sway_icon_ref(struct sway_icon *icon) {
+	++icon->refs;
+	return icon;
+}
+
+void sway_icon_unref(struct sway_icon *icon) {
+	if (!icon || --icon->refs > 0) {
+		return;
+	}
+	for (int i = 0; i < MAX_ICON_BUFFERS; ++i) {
+		if (icon->buffers[i]) {
+			wlr_buffer_drop(&icon->buffers[i]->base);
+		}
+	}
+	if (icon->images) {
+		for (int i = 0; i < icon->images->length; ++i) {
+			cairo_surface_destroy(icon->images->items[i]);
+		}
+		list_free(icon->images);
+	}
+	free(icon->name);
+	free(icon);
+}
+
+void sway_icon_choose_images(const int *sizes, size_t n, bool *keep) {
+	// Keep the largest images (once scaled down to MAX_CLIENT_IMAGE_SIZE), as
+	// scaling down gives better results than scaling up, and only one image of
+	// each size, preferring the smallest source image
+	int kept_sizes[MAX_CLIENT_IMAGES];
+	int n_kept = 0;
+	for (size_t i = 0; i < n; ++i) {
+		keep[i] = false;
+	}
+	while (n_kept < MAX_CLIENT_IMAGES) {
+		size_t best = n;
+		int best_size = 0;
+		for (size_t i = 0; i < n; ++i) {
+			if (keep[i] || sizes[i] <= 0 || sizes[i] > MAX_CLIENT_SOURCE_SIZE) {
+				continue;
+			}
+			int size = MIN(sizes[i], MAX_CLIENT_IMAGE_SIZE);
+			bool taken = false;
+			for (int j = 0; j < n_kept; ++j) {
+				taken |= kept_sizes[j] == size;
+			}
+			if (!taken && (best == n || size > best_size ||
+					(size == best_size && sizes[i] < sizes[best]))) {
+				best = i;
+				best_size = size;
+			}
+		}
+		if (best == n) {
+			break;
+		}
+		keep[best] = true;
+		kept_sizes[n_kept++] = best_size;
+	}
+}
+
+cairo_surface_t *sway_icon_copy_image(cairo_surface_t *image) {
+	int width = cairo_image_surface_get_width(image);
+	int height = cairo_image_surface_get_height(image);
+	if (width <= 0 || height <= 0) {
+		return NULL;
+	}
+	if (MAX(width, height) > MAX_CLIENT_IMAGE_SIZE) {
+		return render_image(image, MAX_CLIENT_IMAGE_SIZE);
+	}
+
+	cairo_surface_t *copy = create_image_surface(width, height);
+	if (!copy) {
+		return NULL;
+	}
+	cairo_t *cairo = cairo_create(copy);
+	cairo_set_operator(cairo, CAIRO_OPERATOR_SOURCE);
+	cairo_set_source_surface(cairo, image, 0, 0);
+	cairo_paint(cairo);
+	cairo_destroy(cairo);
+	cairo_surface_flush(copy);
+	return copy;
+}
+
+struct sway_icon *sway_icon_from_images(list_t *images) {
+	struct sway_icon *icon = icon_create(ICON_IMAGES, NULL, images);
+	if (!icon) {
+		for (int i = 0; i < images->length; ++i) {
+			cairo_surface_destroy(images->items[i]);
+		}
+		list_free(images);
+	}
+	return icon;
+}
+
+static struct cache_entry *cache_find(list_t *cache, const char *key) {
+	if (!cache) {
+		return NULL;
+	}
+	for (int i = 0; i < cache->length; ++i) {
+		struct cache_entry *entry = cache->items[i];
+		if (strcmp(entry->key, key) == 0) {
+			return entry;
+		}
+	}
+	return NULL;
+}
+
+static void cache_clear(list_t *cache) {
+	if (!cache) {
+		return;
+	}
+	for (int i = 0; i < cache->length; ++i) {
+		struct cache_entry *entry = cache->items[i];
+		sway_icon_unref(entry->icon);
+		free(entry->key);
+		free(entry);
+	}
+	cache->length = 0;
+}
+
+static void cache_add(list_t **cache, const char *key, struct sway_icon *icon) {
+	if (!*cache) {
+		*cache = create_list();
+	}
+	if ((*cache)->length >= MAX_CACHE_ENTRIES) {
+		cache_clear(*cache);
+	}
+	struct cache_entry *entry = calloc(1, sizeof(*entry));
+	if (!entry) {
+		return;
+	}
+	entry->key = strdup(key);
+	entry->icon = icon ? sway_icon_ref(icon) : NULL;
+	list_add(*cache, entry);
+}
+
+/**
+ * Checks that the icon can be rendered, so that we can fall back to another
+ * one otherwise.
+ */
+static struct sway_icon *icon_check(struct sway_icon *icon) {
+	int size = config->font_height > 0 ? config->font_height : 16;
+	if (icon && !sway_icon_get_buffer(icon, size)) {
+		sway_icon_unref(icon);
+		return NULL;
+	}
+	return icon;
+}
+
+static struct sway_icon *icon_from_path(const char *path) {
+	struct cache_entry *entry = cache_find(named_icons, path);
+	if (entry) {
+		return entry->icon ? sway_icon_ref(entry->icon) : NULL;
+	}
+	struct sway_icon *icon = icon_check(icon_create(ICON_FILE, path, NULL));
+	cache_add(&named_icons, path, icon);
+	return icon;
+}
+
+struct sway_icon *sway_icon_from_name(const char *name) {
+	if (!name || !*name || strchr(name, '/')) {
+		return NULL;
+	}
+	struct cache_entry *entry = cache_find(named_icons, name);
+	if (entry) {
+		return entry->icon ? sway_icon_ref(entry->icon) : NULL;
+	}
+
+	struct sway_icon *icon = icon_check(icon_create(ICON_NAMED, name, NULL));
+	if (!icon && (has_suffix(name, ".png") || has_suffix(name, ".svg") ||
+			has_suffix(name, ".xpm"))) {
+		// Some desktop entries wrongly include the file extension
+		char *stem = strndup(name, strlen(name) - 4);
+		if (stem) {
+			icon = sway_icon_from_name(stem);
+			free(stem);
+		}
+	}
+	cache_add(&named_icons, name, icon);
+	return icon;
+}
+
+struct sway_icon *sway_icon_for_app(const char *app_id) {
+	if (!app_id || !*app_id) {
+		return NULL;
+	}
+	struct cache_entry *entry = cache_find(app_icons, app_id);
+	if (entry) {
+		return entry->icon ? sway_icon_ref(entry->icon) : NULL;
+	}
+
+	struct sway_icon *icon = NULL;
+	char *icon_name = desktop_entry_find_icon(app_id);
+	if (icon_name) {
+		if (icon_name[0] == '/') {
+			icon = icon_from_path(icon_name);
+		} else {
+			icon = sway_icon_from_name(icon_name);
+		}
+		free(icon_name);
+	}
+
+	// Many applications use their app ID as icon name
+	if (!icon) {
+		icon = sway_icon_from_name(app_id);
+	}
+	if (!icon) {
+		char *lower = strdup(app_id);
+		if (lower) {
+			for (char *c = lower; *c; ++c) {
+				*c = tolower((unsigned char)*c);
+			}
+			if (strcmp(lower, app_id) != 0) {
+				icon = sway_icon_from_name(lower);
+			}
+			free(lower);
+		}
+	}
+
+	sway_log(SWAY_DEBUG, "Application '%s' %s", app_id,
+		icon ? "has an icon" : "has no icon");
+	cache_add(&app_icons, app_id, icon);
+	return icon;
+}
+
+void sway_icons_reset(void) {
+	cache_clear(named_icons);
+	cache_clear(app_icons);
+	icon_themes_reset();
+	desktop_entries_reset();
+}
diff --git a/sway/icon_theme.c b/sway/icon_theme.c
new file mode 100644
index 00000000..124409b7
--- /dev/null
+++ b/sway/icon_theme.c
@@ -0,0 +1,891 @@
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include "config.h"
+#include "list.h"
+#include "log.h"
+#include "stringop.h"
+#include "sway/desktop_entry.h"
+#include "sway/icon_theme.h"
+
+/*
+ * An implementation of icon lookups following the XDG icon theme specification:
+ * https://specifications.freedesktop.org/icon-theme-spec/latest/
+ *
+ * Probing the file system for every directory of a theme is slow (hicolor
+ * alone has hundreds of directories), so we use the icon-theme.cache files
+ * generated by gtk-update-icon-cache when they're present and up to date. For
+ * the other theme directories, we list their contents once.
+ */
+
+// Flags of icon-theme.cache, also used for our own index
+enum {
+	FLAG_XPM = 1 << 0,
+	FLAG_SVG = 1 << 1,
+	FLAG_PNG = 1 << 2,
+};
+
+enum subdir_type {
+	SUBDIR_FIXED,
+	SUBDIR_SCALABLE,
+	SUBDIR_THRESHOLD,
+};
+
+struct theme_subdir {
+	char *name;
+	int index; // in icon_theme.subdirs
+	enum subdir_type type;
+	int size, min_size, max_size, threshold, scale;
+};
+
+struct index_entry {
+	char *name;
+	int subdir; // index in icon_theme.subdirs
+	uint16_t flags;
+};
+
+// A directory containing (a part of) an icon theme, such as
+// /usr/share/icons/hicolor
+struct theme_location {
+	char *path;
+	bool loaded;
+
+	// The contents of icon-theme.cache, if present and up to date
+	uint8_t *cache;
+	size_t cache_size;
+	uint32_t cache_n_dirs;
+	int *cache_subdirs; // icon_theme.subdirs index of each cache directory
+
+	// Otherwise, the icons found in the directory, sorted by name
+	struct index_entry *index;
+	size_t index_len;
+};
+
+struct icon_theme {
+	char *id; // the name of the theme's directory
+	list_t *inherits; // char *
+	list_t *subdirs; // struct theme_subdir *, in the order of the index file
+	struct theme_subdir **subdirs_by_name;
+	list_t *locations; // struct theme_location *
+};
+
+static list_t *basedirs = NULL; // char *
+static list_t *fallback_dirs = NULL; // char *
+static list_t *themes = NULL; // struct icon_theme *
+static list_t *missing_themes = NULL; // char *
+
+static int cmp_str(const void *item, const void *cmp_to) {
+	return strcmp(item, cmp_to);
+}
+
+static bool is_dir(const char *path) {
+	struct stat st;
+	return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static void load_basedirs(void) {
+	if (basedirs) {
+		return;
+	}
+	basedirs = create_list();
+	fallback_dirs = create_list();
+
+	const char *home = getenv("HOME");
+	if (home && *home) {
+		list_add(basedirs, format_str("%s/.icons", home));
+	}
+	list_t *data_dirs = xdg_data_dirs();
+	for (int i = 0; i < data_dirs->length; ++i) {
+		list_add(basedirs, format_str("%s/icons", (char *)data_dirs->items[i]));
+	}
+	for (int i = 0; i < basedirs->length; ++i) {
+		list_add(fallback_dirs, strdup(basedirs->items[i]));
+	}
+	for (int i = 0; i < data_dirs->length; ++i) {
+		list_add(fallback_dirs, format_str("%s/pixmaps", (char *)data_dirs->items[i]));
+	}
+	list_free_items_and_destroy(data_dirs);
+}
+
+static void subdir_destroy(struct theme_subdir *subdir) {
+	free(subdir->name);
+	free(subdir);
+}
+
+static void location_destroy(struct theme_location *loc) {
+	free(loc->path);
+	free(loc->cache);
+	free(loc->cache_subdirs);
+	for (size_t i = 0; i < loc->index_len; ++i) {
+		free(loc->index[i].name);
+	}
+	free(loc->index);
+	free(loc);
+}
+
+static void theme_destroy(struct icon_theme *theme) {
+	free(theme->id);
+	if (theme->inherits) {
+		list_free_items_and_destroy(theme->inherits);
+	}
+	if (theme->subdirs) {
+		for (int i = 0; i < theme->subdirs->length; ++i) {
+			subdir_destroy(theme->subdirs->items[i]);
+		}
+		list_free(theme->subdirs);
+	}
+	free(theme->subdirs_by_name);
+	if (theme->locations) {
+		for (int i = 0; i < theme->locations->length; ++i) {
+			location_destroy(theme->locations->items[i]);
+		}
+		list_free(theme->locations);
+	}
+	free(theme);
+}
+
+struct theme_parse_state {
+	bool has_header;
+	list_t *inherits; // char *
+	list_t *directories; // char *
+	list_t *groups; // struct theme_subdir *
+};
+
+static bool handle_theme_key(void *data, const char *group, const char *key,
+		const char *value) {
+	struct theme_parse_state *state = data;
+
+	if (strcmp(group, "Icon Theme") == 0) {
+		state->has_header = true;
+		if (strcmp(key, "Inherits") == 0 && !state->inherits) {
+			state->inherits = split_string(value, ",");
+		} else if (strcmp(key, "Directories") == 0 ||
+				strcmp(key, "ScaledDirectories") == 0) {
+			list_t *directories = split_string(value, ",");
+			list_cat(state->directories, directories);
+			list_free(directories);
+		}
+		return true;
+	}
+
+	struct theme_subdir *subdir = NULL;
+	if (state->groups->length > 0) {
+		subdir = state->groups->items[state->groups->length - 1];
+	}
+	if (!subdir || strcmp(subdir->name, group) != 0) {
+		subdir = calloc(1, sizeof(*subdir));
+		if (!subdir) {
+			return false;
+		}
+		subdir->name = strdup(group);
+		subdir->type = SUBDIR_THRESHOLD;
+		subdir->min_size = subdir->max_size = -1;
+		subdir->threshold = 2;
+		subdir->scale = 1;
+		list_add(state->groups, subdir);
+	}
+
+	if (strcmp(key, "Type") == 0) {
+		if (strcmp(value, "Fixed") == 0) {
+			subdir->type = SUBDIR_FIXED;
+		} else if (strcmp(value, "Scalable") == 0) {
+			subdir->type = SUBDIR_SCALABLE;
+		} else if (strcmp(value, "Threshold") == 0) {
+			subdir->type = SUBDIR_THRESHOLD;
+		}
+		return true;
+	}
+
+	// Limits keep products like Size * Scale far from overflowing
+	int *field = NULL;
+	long max = 16384;
+	if (strcmp(key, "Size") == 0) {
+		field = &subdir->size;
+	} else if (strcmp(key, "MinSize") == 0) {
+		field = &subdir->min_size;
+	} else if (strcmp(key, "MaxSize") == 0) {
+		field = &subdir->max_size;
+	} else if (strcmp(key, "Threshold") == 0) {
+		field = &subdir->threshold;
+	} else if (strcmp(key, "Scale") == 0) {
+		field = &subdir->scale;
+		max = 16;
+	}
+	if (field) {
+		char *end;
+		long n = strtol(value, &end, 10);
+		if (*end == '\0' && n >= 0 && n <= max) {
+			*field = n;
+		}
+	}
+	return true;
+}
+
+static int cmp_subdir_name(const void *a, const void *b) {
+	const struct theme_subdir *const *subdir_a = a;
+	const struct theme_subdir *const *subdir_b = b;
+	return strcmp((*subdir_a)->name, (*subdir_b)->name);
+}
+
+static struct theme_subdir *find_subdir(struct theme_subdir **subdirs,
+		size_t n_subdirs, const char *name) {
+	struct theme_subdir key = { .name = (char *)name };
+	struct theme_subdir *key_ptr = &key;
+	struct theme_subdir **found = bsearch(&key_ptr, subdirs, n_subdirs,
+		sizeof(*subdirs), cmp_subdir_name);
+	return found ? *found : NULL;
+}
+
+static struct icon_theme *parse_theme(const char *path, const char *id) {
+	struct theme_parse_state state = {
+		.directories = create_list(),
+		.groups = create_list(),
+	};
+	struct icon_theme *theme = NULL;
+
+	if (!desktop_file_parse(path, handle_theme_key, &state) ||
+			!state.has_header) {
+		goto out;
+	}
+
+	theme = calloc(1, sizeof(*theme));
+	if (!theme) {
+		goto out;
+	}
+	theme->id = strdup(id);
+	theme->inherits = state.inherits;
+	state.inherits = NULL;
+	theme->subdirs = create_list();
+	theme->locations = create_list();
+
+	// Find the properties of each directory listed in the index
+	size_t n_groups = state.groups->length;
+	struct theme_subdir **groups = (struct theme_subdir **)state.groups->items;
+	qsort(groups, n_groups, sizeof(*groups), cmp_subdir_name);
+	for (int i = 0; i < state.directories->length; ++i) {
+		struct theme_subdir *group =
+			find_subdir(groups, n_groups, state.directories->items[i]);
+		if (!group || group->size <= 0 || group->scale <= 0 || group->index < 0) {
+			continue; // invalid, or listed twice
+		}
+		struct theme_subdir *subdir = malloc(sizeof(*subdir));
+		if (!subdir) {
+			continue;
+		}
+		*subdir = *group;
+		subdir->name = strdup(group->name);
+		subdir->index = theme->subdirs->length;
+		if (subdir->min_size < 0) {
+			subdir->min_size = subdir->size;
+		}
+		if (subdir->max_size < 0) {
+			subdir->max_size = subdir->size;
+		}
+		group->index = -1;
+		list_add(theme->subdirs, subdir);
+	}
+
+	theme->subdirs_by_name = malloc(sizeof(*theme->subdirs_by_name) *
+		(theme->subdirs->length + 1));
+	if (theme->subdirs_by_name) {
+		memcpy(theme->subdirs_by_name, theme->subdirs->items,
+			sizeof(*theme->subdirs_by_name) * theme->subdirs->length);
+		qsort(theme->subdirs_by_name, theme->subdirs->length,
+			sizeof(*theme->subdirs_by_name), cmp_subdir_name);
+	}
+
+out:
+	if (state.inherits) {
+		list_free_items_and_destroy(state.inherits);
+	}
+	list_free_items_and_destroy(state.directories);
+	for (int i = 0; i < state.groups->length; ++i) {
+		subdir_destroy(state.groups->items[i]);
+	}
+	list_free(state.groups);
+	return theme;
+}
+
+static bool is_valid_name(const char *name) {
+	return name && *name && !strchr(name, '/') &&
+		strcmp(name, ".") != 0 && strcmp(name, "..") != 0;
+}
+
+static struct icon_theme *load_theme(const char *id) {
+	struct icon_theme *theme = NULL;
+	for (int i = 0; i < basedirs->length && !theme; ++i) {
+		char *path = format_str("%s/%s/index.theme",
+			(char *)basedirs->items[i], id);
+		if (path) {
+			theme = parse_theme(path, id);
+			free(path);
+		}
+	}
+	if (!theme) {
+		return NULL;
+	}
+
+	// The icons of a theme can be spread over several base directories
+	for (int i = 0; i < basedirs->length; ++i) {
+		char *path = format_str("%s/%s", (char *)basedirs->items[i], id);
+		if (!path || !is_dir(path)) {
+			free(path);
+			continue;
+		}
+		struct theme_location *loc = calloc(1, sizeof(*loc));
+		if (!loc) {
+			free(path);
+			continue;
+		}
+		loc->path = path;
+		list_add(theme->locations, loc);
+	}
+
+	sway_log(SWAY_DEBUG, "Loaded icon theme '%s' (%d directories, %d locations)",
+		id, theme->subdirs->length, theme->locations->length);
+	return theme;
+}
+
+static struct icon_theme *get_theme(const char *id) {
+	if (!is_valid_name(id)) {
+		return NULL;
+	}
+	for (int i = 0; i < themes->length; ++i) {
+		struct icon_theme *theme = themes->items[i];
+		if (strcmp(theme->id, id) == 0) {
+			return theme;
+		}
+	}
+	if (list_seq_find(missing_themes, cmp_str, id) != -1) {
+		return NULL;
+	}
+
+	struct icon_theme *theme = load_theme(id);
+	if (theme) {
+		list_add(themes, theme);
+	} else {
+		sway_log(SWAY_INFO, "Icon theme '%s' not found", id);
+		list_add(missing_themes, strdup(id));
+	}
+	return theme;
+}
+
+/*
+ * icon-theme.cache files
+ *
+ * All numbers are big-endian. The header contains the version (two 16-bit
+ * numbers, 1 and 0), the offset of the hash table and the offset of the
+ * directory list. The directory list is a count followed by string offsets.
+ * The hash table is a bucket count followed by the offsets of the first icon
+ * in each bucket. An icon is the offset of the next icon in the chain (or
+ * 0xffffffff), the offset of its name and the offset of its image list. An
+ * image list is a count followed by images: a 16-bit directory index, 16-bit
+ * flags and the offset of optional image data.
+ */
+
+static bool cache_u32(struct theme_location *loc, uint64_t offset,
+		uint32_t *out) {
+	if (offset + 4 > loc->cache_size) {
+		return false;
+	}
+	const uint8_t *p = loc->cache + offset;
+	*out = (uint32_t)p[0] << 24 | (uint32_t)p[1] << 16 |
+		(uint32_t)p[2] << 8 | (uint32_t)p[3];
+	return true;
+}
+
+static bool cache_u16(struct theme_location *loc, uint64_t offset,
+		uint16_t *out) {
+	if (offset + 2 > loc->cache_size) {
+		return false;
+	}
+	const uint8_t *p = loc->cache + offset;
+	*out = (uint16_t)(p[0] << 8 | p[1]);
+	return true;
+}
+
+static const char *cache_str(struct theme_location *loc, uint64_t offset) {
+	if (offset >= loc->cache_size) {
+		return NULL;
+	}
+	const char *str = (const char *)loc->cache + offset;
+	return memchr(str, '\0', loc->cache_size - offset) ? str : NULL;
+}
+
+static uint32_t cache_hash(const char *name) {
+	// The hash function used by GTK
+	const signed char *p = (const signed char *)name;
+	uint32_t hash = *p;
+	if (hash) {
+		for (p += 1; *p != '\0'; ++p) {
+			hash = (hash << 5) - hash + *p;
+		}
+	}
+	return hash;
+}
+
+static bool read_file(int fd, uint8_t *data, size_t size) {
+	size_t done = 0;
+	while (done < size) {
+		ssize_t n = read(fd, data + done, size - done);
+		if (n < 0 && errno == EINTR) {
+			continue;
+		}
+		if (n <= 0) {
+			return false;
+		}
+		done += n;
+	}
+	return true;
+}
+
+static bool location_load_cache(struct icon_theme *theme,
+		struct theme_location *loc) {
+	char *path = format_str("%s/icon-theme.cache", loc->path);
+	if (!path) {
+		return false;
+	}
+	struct stat cache_st, dir_st;
+	int fd = open_regular_file(path, 64 * 1024 * 1024, &cache_st);
+	free(path);
+	if (fd < 0) {
+		return false;
+	}
+
+	// Like GTK, ignore caches older than the theme directory
+	if (stat(loc->path, &dir_st) != 0 || cache_st.st_mtime < dir_st.st_mtime ||
+			cache_st.st_size < 12) {
+		close(fd);
+		return false;
+	}
+
+	loc->cache_size = cache_st.st_size;
+	loc->cache = malloc(loc->cache_size);
+	bool ok = loc->cache && read_file(fd, loc->cache, loc->cache_size);
+	close(fd);
+
+	uint16_t major, minor;
+	uint32_t dir_list_offset, n_dirs;
+	ok = ok && cache_u16(loc, 0, &major) && cache_u16(loc, 2, &minor) &&
+		major == 1 && minor == 0 &&
+		cache_u32(loc, 8, &dir_list_offset) &&
+		cache_u32(loc, dir_list_offset, &n_dirs) && n_dirs <= UINT16_MAX + 1;
+	if (ok) {
+		loc->cache_subdirs = calloc(n_dirs + 1, sizeof(*loc->cache_subdirs));
+		ok = loc->cache_subdirs != NULL;
+	}
+	for (uint32_t i = 0; ok && i < n_dirs; ++i) {
+		uint32_t offset;
+		const char *name = NULL;
+		ok = cache_u32(loc, (uint64_t)dir_list_offset + 4 + 4 * (uint64_t)i,
+				&offset) && (name = cache_str(loc, offset));
+		if (ok) {
+			// Directories which aren't listed in index.theme are ignored
+			struct theme_subdir *subdir = theme->subdirs_by_name ?
+				find_subdir(theme->subdirs_by_name, theme->subdirs->length,
+					name) : NULL;
+			loc->cache_subdirs[i] = subdir ? subdir->index : -1;
+		}
+	}
+
+	if (!ok) {
+		sway_log(SWAY_DEBUG, "Ignoring invalid icon cache in %s", loc->path);
+		free(loc->cache);
+		free(loc->cache_subdirs);
+		loc->cache = NULL;
+		loc->cache_subdirs = NULL;
+		loc->cache_size = 0;
+		return false;
+	}
+	loc->cache_n_dirs = n_dirs;
+	return true;
+}
+
+static int cmp_index_entry(const void *a, const void *b) {
+	const struct index_entry *entry_a = a;
+	const struct index_entry *entry_b = b;
+	int cmp = strcmp(entry_a->name, entry_b->name);
+	if (cmp != 0) {
+		return cmp;
+	}
+	return entry_a->subdir - entry_b->subdir;
+}
+
+static void location_build_index(struct icon_theme *theme,
+		struct theme_location *loc) {
+	size_t capacity = 0;
+	for (int i = 0; i < theme->subdirs->length; ++i) {
+		struct theme_subdir *subdir = theme->subdirs->items[i];
+		char *path = format_str("%s/%s", loc->path, subdir->name);
+		DIR *dir = path ? opendir(path) : NULL;
+		free(path);
+		if (!dir) {
+			continue;
+		}
+
+		struct dirent *dirent;
+		while ((dirent = readdir(dir))) {
+			const char *name = dirent->d_name;
+			const char *ext = strrchr(name, '.');
+			if (!ext || ext == name) {
+				continue;
+			}
+			uint16_t flags;
+			if (strcmp(ext, ".png") == 0) {
+				flags = FLAG_PNG;
+			} else if (strcmp(ext, ".svg") == 0) {
+				flags = FLAG_SVG;
+			} else if (strcmp(ext, ".xpm") == 0) {
+				flags = FLAG_XPM;
+			} else {
+				continue;
+			}
+
+			if (loc->index_len == capacity) {
+				size_t new_capacity = capacity ? capacity * 2 : 64;
+				struct index_entry *index = realloc(loc->index,
+					new_capacity * sizeof(*index));
+				if (!index) {
+					break;
+				}
+				loc->index = index;
+				capacity = new_capacity;
+			}
+			char *icon_name = strndup(name, ext - name);
+			if (!icon_name) {
+				break;
+			}
+			loc->index[loc->index_len++] = (struct index_entry){
+				.name = icon_name,
+				.subdir = i,
+				.flags = flags,
+			};
+		}
+		closedir(dir);
+	}
+
+	if (loc->index_len > 0) {
+		qsort(loc->index, loc->index_len, sizeof(*loc->index), cmp_index_entry);
+	}
+	sway_log(SWAY_DEBUG, "Indexed %zu icons in %s", loc->index_len, loc->path);
+}
+
+static void location_load(struct icon_theme *theme, struct theme_location *loc) {
+	if (loc->loaded) {
+		return;
+	}
+	loc->loaded = true;
+	if (!location_load_cache(theme, loc)) {
+		location_build_index(theme, loc);
+	}
+}
+
+/*
+ * Lookups
+ *
+ * The specification picks the first icon in a directory matching the size
+ * exactly, and otherwise the icon in the directory with the closest size. We
+ * render icons at arbitrary sizes (the height of the title bar font), so we
+ * use a slightly different order of preference, to avoid blurry upscaling:
+ * 1. a raster image of exactly the right size,
+ * 2. a vector image (from the directory closest in size, preferring the one
+ *    made for the closest size, since themes may give their directories
+ *    overlapping size ranges),
+ * 3. the smallest raster image larger than the requested size,
+ * 4. the largest raster image smaller than the requested size.
+ */
+
+struct icon_search {
+	const char *name;
+	int size;
+
+	bool found;
+	int rank, distance, closeness;
+	struct theme_location *loc;
+	struct theme_subdir *subdir;
+	enum icon_file_format format;
+};
+
+#if HAVE_LIBRSVG
+static int subdir_distance(struct theme_subdir *subdir, int size) {
+	int min, max;
+	switch (subdir->type) {
+	case SUBDIR_FIXED:
+		min = max = subdir->size;
+		break;
+	case SUBDIR_SCALABLE:
+		min = subdir->min_size;
+		max = subdir->max_size;
+		break;
+	case SUBDIR_THRESHOLD:
+	default:
+		min = subdir->size - subdir->threshold;
+		max = subdir->size + subdir->threshold;
+		break;
+	}
+	min *= subdir->scale;
+	max *= subdir->scale;
+	if (size < min) {
+		return min - size;
+	} else if (size > max) {
+		return size - max;
+	}
+	return 0;
+}
+#endif
+
+static void search_offer(struct icon_search *search, struct theme_location *loc,
+		struct theme_subdir *subdir, enum icon_file_format format,
+		int rank, int distance) {
+	// How far the size the image was made for is from the requested size
+	long nominal = (long)subdir->size * subdir->scale;
+	int closeness = labs(nominal - search->size) > INT_MAX ?
+		INT_MAX : (int)labs(nominal - search->size);
+	if (search->found && (rank > search->rank ||
+			(rank == search->rank && (distance > search->distance ||
+			(distance == search->distance && closeness >= search->closeness))))) {
+		return;
+	}
+	search->found = true;
+	search->rank = rank;
+	search->distance = distance;
+	search->closeness = closeness;
+	search->loc = loc;
+	search->subdir = subdir;
+	search->format = format;
+}
+
+static void search_consider(struct icon_search *search,
+		struct icon_theme *theme, struct theme_location *loc, int subdir_index,
+		uint16_t flags) {
+	if (subdir_index < 0 || subdir_index >= theme->subdirs->length) {
+		return;
+	}
+	struct theme_subdir *subdir = theme->subdirs->items[subdir_index];
+
+	if (flags & FLAG_PNG) {
+		int size = subdir->size * subdir->scale;
+		if (size == search->size) {
+			search_offer(search, loc, subdir, ICON_FORMAT_PNG, 0, 0);
+		} else if (size > search->size) {
+			search_offer(search, loc, subdir, ICON_FORMAT_PNG, 2,
+				size - search->size);
+		} else {
+			search_offer(search, loc, subdir, ICON_FORMAT_PNG, 3,
+				search->size - size);
+		}
+	}
+#if HAVE_LIBRSVG
+	if (flags & FLAG_SVG) {
+		search_offer(search, loc, subdir, ICON_FORMAT_SVG, 1,
+			subdir_distance(subdir, search->size));
+	}
+#endif
+}
+
+static void search_cache(struct icon_search *search, struct icon_theme *theme,
+		struct theme_location *loc) {
+	uint32_t hash_offset, n_buckets, offset;
+	if (!cache_u32(loc, 4, &hash_offset) ||
+			!cache_u32(loc, hash_offset, &n_buckets) || n_buckets == 0) {
+		return;
+	}
+	uint32_t bucket = cache_hash(search->name) % n_buckets;
+	if (!cache_u32(loc, (uint64_t)hash_offset + 4 + 4 * (uint64_t)bucket,
+			&offset)) {
+		return;
+	}
+
+	// Limit the length of the chain in case of a corrupt file
+	for (int i = 0; offset != UINT32_MAX && i < 100000; ++i) {
+		uint32_t name_offset, images_offset, n_images;
+		if (!cache_u32(loc, (uint64_t)offset + 4, &name_offset) ||
+				!cache_u32(loc, (uint64_t)offset + 8, &images_offset)) {
+			return;
+		}
+		const char *name = cache_str(loc, name_offset);
+		if (name && strcmp(name, search->name) == 0) {
+			if (!cache_u32(loc, images_offset, &n_images)) {
+				return;
+			}
+			for (uint32_t j = 0; j < n_images; ++j) {
+				uint64_t image = (uint64_t)images_offset + 4 + 8 * (uint64_t)j;
+				uint16_t dir, flags;
+				if (!cache_u16(loc, image, &dir) ||
+						!cache_u16(loc, image + 2, &flags)) {
+					return;
+				}
+				if (dir < loc->cache_n_dirs) {
+					search_consider(search, theme, loc,
+						loc->cache_subdirs[dir], flags);
+				}
+			}
+			return;
+		}
+		if (!cache_u32(loc, offset, &offset)) {
+			return;
+		}
+	}
+}
+
+static void search_index(struct icon_search *search, struct icon_theme *theme,
+		struct theme_location *loc) {
+	if (loc->index_len == 0) {
+		return;
+	}
+	// Find the first entry with the name
+	size_t lo = 0, hi = loc->index_len;
+	while (lo < hi) {
+		size_t mid = lo + (hi - lo) / 2;
+		if (strcmp(loc->index[mid].name, search->name) < 0) {
+			lo = mid + 1;
+		} else {
+			hi = mid;
+		}
+	}
+	for (size_t i = lo; i < loc->index_len &&
+			strcmp(loc->index[i].name, search->name) == 0; ++i) {
+		search_consider(search, theme, loc, loc->index[i].subdir,
+			loc->index[i].flags);
+	}
+}
+
+static bool search_theme(struct icon_search *search, struct icon_theme *theme) {
+	for (int i = 0; i < theme->locations->length; ++i) {
+		struct theme_location *loc = theme->locations->items[i];
+		location_load(theme, loc);
+		if (loc->cache) {
+			search_cache(search, theme, loc);
+		} else {
+			search_index(search, theme, loc);
+		}
+	}
+	return search->found;
+}
+
+static bool search_theme_tree(struct icon_search *search, const char *id,
+		list_t *visited, int depth) {
+	if (depth > 16 || list_seq_find(visited, cmp_str, id) != -1) {
+		return false;
+	}
+	list_add(visited, strdup(id));
+
+	struct icon_theme *theme = get_theme(id);
+	if (!theme) {
+		return false;
+	}
+	if (search_theme(search, theme)) {
+		return true;
+	}
+	if (theme->inherits) {
+		for (int i = 0; i < theme->inherits->length; ++i) {
+			if (search_theme_tree(search, theme->inherits->items[i], visited,
+					depth + 1)) {
+				return true;
+			}
+		}
+	}
+	return false;
+}
+
+static bool find_fallback(const char *name, struct icon_file *file) {
+	static const struct {
+		const char *ext;
+		enum icon_file_format format;
+	} formats[] = {
+#if HAVE_LIBRSVG
+		{ "svg", ICON_FORMAT_SVG },
+#endif
+		{ "png", ICON_FORMAT_PNG },
+	};
+
+	for (int i = 0; i < fallback_dirs->length; ++i) {
+		for (size_t j = 0; j < sizeof(formats) / sizeof(formats[0]); ++j) {
+			char *path = format_str("%s/%s.%s",
+				(char *)fallback_dirs->items[i], name, formats[j].ext);
+			if (path && access(path, R_OK) == 0) {
+				file->path = path;
+				file->format = formats[j].format;
+				file->size = 0;
+				return true;
+			}
+			free(path);
+		}
+	}
+	return false;
+}
+
+bool icon_theme_find(const char *theme, const char *name, int size,
+		struct icon_file *file) {
+	*file = (struct icon_file){0};
+	if (!is_valid_name(name) || size <= 0) {
+		return false;
+	}
+
+	load_basedirs();
+	if (!themes) {
+		themes = create_list();
+		missing_themes = create_list();
+	}
+
+	struct icon_search search = {
+		.name = name,
+		.size = size,
+	};
+	list_t *visited = create_list();
+	bool found = (theme && search_theme_tree(&search, theme, visited, 0)) ||
+		search_theme_tree(&search, "hicolor", visited, 0);
+	list_free_items_and_destroy(visited);
+
+	if (found) {
+		file->path = format_str("%s/%s/%s.%s", search.loc->path,
+			search.subdir->name, name,
+			search.format == ICON_FORMAT_SVG ? "svg" : "png");
+		file->format = search.format;
+		file->size = search.format == ICON_FORMAT_PNG ?
+			search.subdir->size * search.subdir->scale : 0;
+	} else {
+		found = find_fallback(name, file);
+	}
+
+	if (found && file->path) {
+		sway_log(SWAY_DEBUG, "Icon '%s' at %dpx: %s", name, size, file->path);
+		return true;
+	}
+	sway_log(SWAY_DEBUG, "Icon '%s' not found", name);
+	icon_file_finish(file);
+	return false;
+}
+
+void icon_file_finish(struct icon_file *file) {
+	free(file->path);
+	file->path = NULL;
+}
+
+void icon_themes_reset(void) {
+	if (themes) {
+		for (int i = 0; i < themes->length; ++i) {
+			theme_destroy(themes->items[i]);
+		}
+		list_free(themes);
+		themes = NULL;
+	}
+	if (missing_themes) {
+		list_free_items_and_destroy(missing_themes);
+		missing_themes = NULL;
+	}
+	if (basedirs) {
+		list_free_items_and_destroy(basedirs);
+		basedirs = NULL;
+	}
+	if (fallback_dirs) {
+		list_free_items_and_destroy(fallback_dirs);
+		fallback_dirs = NULL;
+	}
+}
