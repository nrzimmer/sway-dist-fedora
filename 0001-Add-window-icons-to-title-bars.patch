diff --git a/include/sway/desktop_entry.h b/include/sway/desktop_entry.h
new file mode 100644
index 00000000..dc0cbdbd
--- /dev/null
+++ b/include/sway/desktop_entry.h
@@ -0,0 +1,55 @@
+#ifndef _SWAY_DESKTOP_ENTRY_H
+#define _SWAY_DESKTOP_ENTRY_H
+#include <stdbool.h>
+#include <stddef.h>
+#include <sys/stat.h>
+#include "list.h"
+
+/**
+ * Opens a file for reading if it's a regular file of at most max_size bytes
+ * (opening a FIFO would block), filling st if not NULL. Returns -1 otherwise.
+ */
+int open_regular_file(const char *path, size_t max_size, struct stat *st);
+
+/**
+ * Reads a whole regular file of at most max_size bytes, see open_regular_file.
+ * Returns the newly allocated contents, or NULL on failure.
+ */
+char *read_regular_file(const char *path, size_t max_size, size_t *len,
+		struct stat *st);
+
+/**
+ * Returns $XDG_DATA_HOME followed by the directories in $XDG_DATA_DIRS,
+ * applying the defaults from the base directory specification. Free with
+ * list_free_items_and_destroy().
+ */
+list_t *xdg_data_dirs(void);
+
+/**
+ * Called for every key in a desktop entry file. Return false to stop parsing.
+ */
+typedef bool (*desktop_file_handler_t)(void *data, const char *group,
+		const char *key, const char *value);
+
+/**
+ * Parses a file in the XDG desktop entry format, which is also used by icon
+ * theme index files. Returns false if the file couldn't be read.
+ */
+bool desktop_file_parse(const char *path, desktop_file_handler_t handler,
+		void *data);
+
+/**
+ * Finds the icon (the value of its Icon key) of the desktop entry matching an
+ * application identifier: a Wayland app_id, a sandbox app ID or an X11 class.
+ * Returns a newly allocated string, or NULL if no matching desktop entry with
+ * an icon was found.
+ */
+char *desktop_entry_find_icon(const char *app_id);
+
+/**
+ * Forgets all desktop entries read so far, so that they are read again on the
+ * next lookup.
+ */
+void desktop_entries_reset(void);
+
+#endif
diff --git a/include/sway/icon.h b/include/sway/icon.h
new file mode 100644
index 00000000..c8abb1c0
--- /dev/null
+++ b/include/sway/icon.h
@@ -0,0 +1,64 @@
+#ifndef _SWAY_ICON_H
+#define _SWAY_ICON_H
+#include <cairo.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include "list.h"
+
+struct wlr_buffer;
+
+/**
+ * A reference-counted icon, which can be rendered at any size: either an icon
+ * from the icon theme, an image file, or pixel data provided by a client.
+ */
+struct sway_icon;
+
+/**
+ * Looks up an icon by name in the configured icon theme. Returns NULL if
+ * there's no such icon.
+ */
+struct sway_icon *sway_icon_from_name(const char *name);
+
+/**
+ * Creates an icon from images of different sizes, typically provided by a
+ * client. Takes ownership of the list and of the cairo image surfaces in it.
+ */
+struct sway_icon *sway_icon_from_images(list_t *images);
+
+/**
+ * Icons are only shown in title bars, so we keep only a few images of the ones
+ * a client provides: given their sizes, sets keep[i] for the images to copy
+ * with sway_icon_copy_image().
+ */
+void sway_icon_choose_images(const int *sizes, size_t n, bool *keep);
+
+/**
+ * Copies an image provided by a client, scaling it down if it's larger than
+ * needed. Returns NULL on failure.
+ */
+cairo_surface_t *sway_icon_copy_image(cairo_surface_t *image);
+
+/**
+ * Finds the icon of an application, given its app_id, sandbox app ID or X11
+ * class: the icon of its desktop entry if there is one, or else the icon named
+ * after it. Returns NULL if no icon was found.
+ */
+struct sway_icon *sway_icon_for_app(const char *app_id);
+
+struct sway_icon *sway_icon_ref(struct sway_icon *icon);
+
+void sway_icon_unref(struct sway_icon *icon);
+
+/**
+ * Returns the icon rendered at size×size pixels, or NULL on failure. Rendered
+ * buffers are cached: the buffer belongs to the icon, lock it to keep it.
+ */
+struct wlr_buffer *sway_icon_get_buffer(struct sway_icon *icon, int size);
+
+/**
+ * Forgets all cached icons and lookup results, and the icon themes and desktop
+ * entries read so far.
+ */
+void sway_icons_reset(void);
+
+#endif
diff --git a/include/sway/icon_theme.h b/include/sway/icon_theme.h
new file mode 100644
index 00000000..510bb90f
--- /dev/null
+++ b/include/sway/icon_theme.h
@@ -0,0 +1,36 @@
+#ifndef _SWAY_ICON_THEME_H
+#define _SWAY_ICON_THEME_H
+#include <stdbool.h>
+
+enum icon_file_format {
+	ICON_FORMAT_PNG,
+	ICON_FORMAT_SVG,
+};
+
+struct icon_file {
+	char *path;
+	enum icon_file_format format;
+	int size; // the size the image was made for in pixels, or 0 if unknown
+};
+
+/**
+ * Finds the image file that best represents the icon `name` at `size`×`size`
+ * pixels, following the XDG icon theme specification: the icon is looked up
+ * in `theme` (which may be NULL), the themes it inherits from, the hicolor
+ * theme and finally in the fallback directories (e.g. /usr/share/pixmaps).
+ *
+ * Returns false if there is no such icon. On success, release the file with
+ * icon_file_finish().
+ */
+bool icon_theme_find(const char *theme, const char *name, int size,
+		struct icon_file *file);
+
+void icon_file_finish(struct icon_file *file);
+
+/**
+ * Forgets all icon themes loaded so far, so that changes on disk are picked
+ * up by the next lookups.
+ */
+void icon_themes_reset(void);
+
+#endif
